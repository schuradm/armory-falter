includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - app
        - config
        - database
        - routes
    tmpDir: storage/framework/cache/phpstan
    ignoreErrors:
        # Seeder laufen auch ohne Konsole (z. B. aus Migrationen), $this->command ist dann null
        -
            identifier: nullsafe.neverNull
            path: database/seeders/*
        # Die Demo-Daten sind fest, die Bedingungen gelten für künftige Einträge
        -
            identifier: greater.alwaysTrue
            path: database/seeders/ProductSeeder.php
