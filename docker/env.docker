# Testumgebung (Docker). Wird beim ersten Start nach storage/app/.env.docker kopiert.
APP_NAME="Armory Falter"
APP_ENV=staging
APP_NOINDEX=true
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

LOG_CHANNEL=daily
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=armory
DB_USERNAME=armory
DB_PASSWORD=armory

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Alle Mails landen in Mailpit: http://<Server-IP>:8025
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="shop@armory-falter.de"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@armory-falter.de
# Leer = zufälliges Passwort, steht nach dem ersten Start in: docker compose logs app
ADMIN_PASSWORD=

# Zahlungen in der Testumgebung nur im Sandbox-Modus eintragen
