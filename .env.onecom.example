# =============================================================================
# Armory Falter – Produktions-Einstellungen für One.com
#
# So geht's: Diese Datei auf dem Server zu ".env" kopieren (gleicher Ordner wie
# "artisan") und alle Werte in <SPITZEN_KLAMMERN> ersetzen.
# Die .env enthält Passwörter: niemals per E-Mail verschicken, nicht in Git,
# Kopie im Passwortmanager ablegen.
# =============================================================================

# --- Anwendung -------------------------------------------------------------------
APP_NAME="Armory Falter"
APP_ENV=production
# Leer lassen: der Installer (install.php) erzeugt den Schlüssel einmalig.
# Danach NIE mehr ändern, sonst sind verschlüsselte Daten (Dokumente, 2FA) verloren.
APP_KEY=
APP_DEBUG=false
# Für den Test zuerst https://test.armory-falter.de, beim Go-live https://www.armory-falter.de
APP_URL=https://www.armory-falter.de

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Protokolle (täglich eine Datei in storage/logs, 14 Tage aufbewahren) ----------
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Datenbank ---------------------------------------------------------------------
# Werte aus dem One.com-Kontrollpanel: Erweiterte Einstellungen -> PHP- und Datenbank-
# Einstellungen -> MySQL. Der Host sieht dort ungefähr so aus:
# <kennung>.mysql.service.one.com (NICHT "localhost" verwenden, wenn dort etwas anderes steht).
DB_CONNECTION=mysql
DB_HOST=<DATENBANK_HOST>
DB_PORT=3306
DB_DATABASE=<DATENBANK_NAME>
DB_USERNAME=<DATENBANK_BENUTZER>
DB_PASSWORD="<DATENBANK_PASSWORT>"

# --- Sitzungen, Cache, Warteschlange (alles ohne Redis, passend für Shared Hosting) --
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# "file" ist auf One.com am schnellsten; alternativ "database".
CACHE_STORE=file
CACHE_PREFIX=af_

# Aufträge (E-Mails, Bildvarianten) werden vom Cron-Aufruf jede Minute abgearbeitet.
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- E-Mail über One.com (Postfach im Kontrollpanel unter "E-Mail" anlegen) -----------
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=send.one.com
MAIL_PORT=465
MAIL_USERNAME=<shop@armory-falter.de>
MAIL_PASSWORD="<POSTFACH_PASSWORT>"
MAIL_FROM_ADDRESS="shop@armory-falter.de"
MAIL_FROM_NAME="${APP_NAME}"

# --- Zahlungen: PayPal ---------------------------------------------------------------
# Zugangsdaten: developer.paypal.com -> Apps & Credentials (Live!). Zum Testen SANDBOX=true.
PAYPAL_ENABLED=false
PAYPAL_SANDBOX=true
PAYPAL_CLIENT_ID=<PAYPAL_CLIENT_ID>
PAYPAL_SECRET=<PAYPAL_SECRET>
# Webhook-URL bei PayPal: https://www.armory-falter.de/webhooks/paypal
PAYPAL_WEBHOOK_ID=<PAYPAL_WEBHOOK_ID>

# --- Zahlungen: Klarna (Sofortüberweisung "pay_now" / Rechnung) ------------------------
# Zugangsdaten aus dem Klarna Merchant Portal. Zum Testen PLAYGROUND=true.
KLARNA_ENABLED=false
KLARNA_SOFORT_ENABLED=false
KLARNA_PLAYGROUND=true
KLARNA_USERNAME=<KLARNA_API_BENUTZER>
KLARNA_PASSWORD="<KLARNA_API_PASSWORT>"

CARD_ENABLED=false
WEAPON_PSP_ENABLED=false

# --- Spam-Schutz für Formulare (Cloudflare Turnstile, kostenlos) ------------------------
CAPTCHA_DRIVER=turnstile
TURNSTILE_SITE_KEY=<TURNSTILE_SITE_KEY>
TURNSTILE_SECRET=<TURNSTILE_SECRET>

# --- Sicherheit ---------------------------------------------------------------------------
# Zufallswert für Such-Indizes verschlüsselter Felder. Einmal setzen, nie mehr ändern.
# Erzeugen z. B. mit: https://www.random.org/strings/ (64 Zeichen) oder Passwortmanager.
BLIND_INDEX_KEY=<64_ZUFALLSZEICHEN>

# Geheimer Teil der Cron-Adresse: https://www.armory-falter.de/cron/<CRON_TOKEN>
# Mindestens 40 zufällige Buchstaben/Ziffern, keine Sonderzeichen.
CRON_TOKEN=<40_ZUFALLSZEICHEN>

# Nur für den Installer (public/install.php). Mindestens 32 zufällige Zeichen.
# Jeder Token funktioniert genau einmal. Nach der Installation leeren und
# public/install.php löschen!
INSTALL_TOKEN=<32_ODER_MEHR_ZUFALLSZEICHEN>

# Erster Admin-Zugang (wird vom Seeder angelegt). Nach dem ersten Login Passwort
# im Backend ändern, 2FA einrichten und diese beiden Zeilen hier leeren.
ADMIN_EMAIL=<info@armory-falter.de>
ADMIN_PASSWORD="<STARKES_PASSWORT>"

# --- Shop-Stammdaten (Impressum, Rechnungen) -------------------------------------------
SHOP_COMPANY_NAME="Armory Falter"
SHOP_COMPANY_OWNER="<INHABER>"
SHOP_COMPANY_STREET="<STRASSE NR>"
SHOP_COMPANY_ZIP=<PLZ>
SHOP_COMPANY_CITY="<ORT>"
SHOP_COMPANY_PHONE="<TELEFON>"
SHOP_COMPANY_EMAIL="info@armory-falter.de"
SHOP_COMPANY_VAT_ID=<USTID>
SHOP_COMPANY_TAX_NUMBER=<STEUERNUMMER>
SHOP_WEAPON_AUTHORITY="<ZUSTAENDIGE_WAFFENBEHOERDE>"
SHOP_BANK_HOLDER="<KONTOINHABER>"
SHOP_BANK_NAME="<BANK>"
SHOP_BANK_IBAN=<IBAN>
SHOP_BANK_BIC=<BIC>

# --- Leistung -------------------------------------------------------------------------------
PAGE_CACHE=true
INLINE_CSS=false

VITE_APP_NAME="${APP_NAME}"
