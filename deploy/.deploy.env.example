# Zugangsdaten für deploy/upload-sftp.sh bzw. deploy/upload-winscp.bat
# Kopieren nach deploy/.deploy.env (steht in .gitignore, wird NIE committet
# und nie ins ZIP gepackt). Werte aus dem One.com-Kontrollpanel -> "SSH & SFTP".

SFTP_HOST=ssh.example.one.com
SFTP_PORT=22
SFTP_USER=armory-falter.de
SFTP_PASS=
# Optional statt Passwort: privater Schlüssel (OpenSSH-Format)
SFTP_KEY=

# Zielordner auf dem Webspace, relativ zum Login-Ordner.
# Test-Subdomain: Ordner aus "Erweiterte Einstellungen -> Subdomains -> Ordner"
# Live (nach dem Go-live): meist httpd.www bzw. /www
REMOTE_DIR=test.armory-falter.de

# Erwarteter SSH-Host-Schlüssel (Fingerabdruck aus dem Panel/Support), nur WinSCP:
# z. B. ssh-ed25519 255 AbCdEf...=
SFTP_HOSTKEY=
