# =============================================================================
# Armory Falter – public/.htaccess (Apache 2.4, One.com Shared Hosting)
#
# Gilt in beiden Varianten:
#   a) Dokumentenwurzel zeigt direkt auf public/
#   b) Dokumentenwurzel ist der Projektordner, die Root-.htaccess leitet
#      intern nach public/ weiter (Standard auf One.com)
#
# Sicherheits-Header für PHP-Antworten setzt die App selbst
# (App\Http\Middleware\SecurityHeaders: nosniff, X-Frame-Options, Referrer-
# Policy, Permissions-Policy, COOP, HSTS, CSP). Hier werden sie deshalb NUR
# für statische Dateien gesetzt, damit keine Header doppelt ankommen.
# =============================================================================

Options -Indexes
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Punktdateien sperren (.env, .git, .htaccess …), .well-known erlauben
    RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]

    # --- HTTPS erzwingen ------------------------------------------------------
    # Prüft auch X-Forwarded-Proto (falls TLS vor dem Webserver endet).
    # Bei einer Weiterleitungsschleife die drei Zeilen auskommentieren.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L,NE]

    # --- Kanonischer Host: armory-falter.de -> www.armory-falter.de ----------
    # >>> HOST HIER ANPASSEN (nur diese zwei Zeilen) <<<
    # Subdomains wie test.armory-falter.de sind bewusst NICHT betroffen.
    RewriteCond %{HTTP_HOST} ^armory-falter\.de$ [NC]
    RewriteRule ^(.*)$ https://www.armory-falter.de/$1 [R=301,L,NE]

    # --- Wer "/public/…" direkt aufruft, bekommt die saubere Adresse ---------
    # (nur relevant, wenn die Root-.htaccess nach public/ umleitet)
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+public(/|\?|\s) [NC]
    RewriteRule ^(.*)$ /$1 [R=301,L,NE]

    # --- Authorization- und X-XSRF-Token-Header an PHP durchreichen ----------
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # --- Abschließenden Schrägstrich entfernen (wenn kein Ordner) ------------
    # $1 ist relativ zu public/ – funktioniert dadurch in Variante a) und b).
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # --- Alles Übrige an den Front-Controller --------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# --- Kompression ---------------------------------------------------------------
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/rss+xml application/manifest+json image/svg+xml font/ttf font/otf
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/rss+xml application/manifest+json image/svg+xml font/ttf font/otf
</IfModule>

# --- MIME-Typen ------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType image/webp .webp
    AddType image/avif .avif
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml .svg
</IfModule>

# --- Cache-Header und Sicherheits-Header für statische Dateien -----------------
# PHP-Antworten (HTML) bestimmen ihre Cache-Header selbst (Seiten-Cache-Middleware),
# hier wird nichts daran geändert.
<IfModule mod_headers.c>
    # Vite-Build (/build, Dateinamen mit Hash), Schriften, Bilder, Filament-Assets
    # (Filament hängt ?v=… an): 1 Jahr, unveränderlich.
    <FilesMatch "\.(css|js|mjs|map|woff2?|ttf|otf|eot|png|jpe?g|gif|webp|avif|svg|ico|mp4|webm)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set X-Content-Type-Options "nosniff"
        Header unset ETag
    </FilesMatch>
    # Kleine Text-Dateien ohne Hash: kurz cachen.
    <FilesMatch "\.(txt|xml|webmanifest|json|html?)$">
        Header set Cache-Control "public, max-age=3600"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
    # favicon.ico wird nie umbenannt: 1 Woche statt 1 Jahr.
    <Files "favicon.ico">
        Header set Cache-Control "public, max-age=604800"
    </Files>
    # Schriften dürfen von www und Nicht-www geladen werden.
    <FilesMatch "\.(woff2?|ttf|otf)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>
FileETag None

# --- Sensible Dateien zusätzlich sperren (falls mod_rewrite fehlt) -------------
<FilesMatch "(^\.|\.(env|log|sql|sqlite|bak|swp|ini|sh|lock|dist)$|^(composer|package)(-lock)?\.json$)">
    Require all denied
</FilesMatch>
